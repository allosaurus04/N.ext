{
  "manifest_version": 3,
  "name": "N.ext",
  "version": "1.0.0",
  "description": "A Chrome extension for Canvas, made for NUS students. Hence, the name N.ext.",
  "icons": {
  "16": "assets/icon16.png",
  "48": "assets/icon48.png",
  "128": "assets/icon128.png"
  },
  "action": {
  "default_popup": "popup/popup.html"
},
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://canvas.nus.edu.sg/*"],
      "js": ["content/content.js", "content/file_downloader.js", "content/linus.js"],
      "css": ["content/content.css", "content/theme.css", "content/linus.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/lion.jpg", "assets/download.png"],
      "matches": ["https://canvas.nus.edu.sg/*"]
    }
  ],
  "permissions": ["storage", "downloads"]
}