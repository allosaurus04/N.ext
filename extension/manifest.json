{
  "manifest_version": 3,
  "name": "N.ext",
  "version": "1.3.4",
  "description": "A Chrome extension for Canvas, made for NUS students. Hence, the name N.ext.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://canvas.nus.edu.sg/*"],
      "js": ["content/content.js", "content/file_downloader.js"],
      "css": ["content/content.css", "content/theme.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/lion.jpg", "assets/download.png", "assets/linus.png"],
      "matches": ["https://canvas.nus.edu.sg/*"]
    }
  ],
  "permissions": ["storage", "downloads"] 
}